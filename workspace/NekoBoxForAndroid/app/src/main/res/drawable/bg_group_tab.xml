<?xml version="1.0" encoding="utf-8"?>
<!--
    Оформление вкладок-подписок на главном экране (layout_group_list.xml).
    Активная подписка выделяется акцентной «пилюлей», остальные — мягкой
    поверхностью. Работает для любого количества подписок (tabMode=scrollable).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset
            android:insetTop="7dp"
            android:insetBottom="7dp"
            android:insetLeft="4dp"
            android:insetRight="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="16dp" />
                <solid android:color="@color/group_tab_selected" />
                <stroke
                    android:width="1dp"
                    android:color="@color/group_tab_selected_stroke" />
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:insetTop="7dp"
            android:insetBottom="7dp"
            android:insetLeft="4dp"
            android:insetRight="4dp">
            <shape android:shape="rectangle">
                <corners android:radius="16dp" />
                <solid android:color="@color/theme_surface_container_high" />
            </shape>
        </inset>
    </item>
</selector>
